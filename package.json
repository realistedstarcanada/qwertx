{
  "name": "qwertx",
  "private": true,
  "version": "1.0.0",
  "description": "QWERTx \u2014 super investor portfolios, politician and insider trades, market mood and news. Static site, zero dependencies.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node scripts/serve.mjs",
    "data:13f": "node scripts/fetch-13f.mjs",
    "data:news": "node scripts/fetch-news.mjs",
    "data:market": "node scripts/fetch-market.mjs",
    "data:congress": "node scripts/fetch-congress.mjs",
    "data:insiders": "node scripts/fetch-insiders.mjs",
    "data:calendar": "node scripts/fetch-calendar.mjs",
    "data:8k": "node scripts/fetch-8k.mjs",
    "data:macro": "node scripts/fetch-macro.mjs",
    "data:etfs": "node scripts/fetch-etfs.mjs",
    "data:vendor": "node scripts/fetch-fmp.mjs",
    "data:tickers": "node scripts/fetch-tickers.mjs",
    "data:tsx": "node scripts/fetch-tsx.mjs",
    "data:trump": "node scripts/fetch-trump.mjs",
    "data:featured": "node scripts/fetch-featured.mjs",
    "test": "node --no-warnings --import ./test/harness/json-hook.mjs --test test/*.test.mjs"
  }
}
